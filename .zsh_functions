# Return 0 if the terminal is likely able to display emoji, 1 otherwise.
function can_display_emoji {
  if [[ "${FORCE_EMOJI}" == "0" ]]; then
    return 1
  fi

  if [[ "${FORCE_EMOJI}" == "1" ]]; then
    return 0
  fi

  local locale=${LC_ALL:-${LC_CTYPE:-${LANG:-}}}

  if [[ -z ${locale} ]]; then
    return 1
  fi

  if [[ "${locale}" != *UTF-8* && "${locale}" != *utf8* ]]; then
    return 1
  fi

  if [[ -z "${TERM}" || "${TERM}" == "dumb" ]]; then
    return 1
  fi

  return 0
}

# Print Completed or Failed Based On The Last
# Command Exit Status.
function _print-cmd-status {
  local last_status=${?}
  local success_message
  local failure_message

  if [[ ${1} == "txt" ]]; then
    success_message="Completed"
    failure_message="Failed"
  else
    if can_display_emoji; then
      success_message="✅"
      failure_message="❌"
    else
      success_message="Completed"
      failure_message="Failed"
    fi
  fi

  if [[ ${last_status} -eq 0 ]]; then
    echo "${success_message}${WHITE}."
  else
    echo "${failure_message}${WHITE}."
  fi

  return ${last_status}
}

# Print A Header Used For CLI Output
# $1 = Header Text
function _print-header {
  local header_char="*"
  local header_cols=65
  local printed_header_char=0

  echo -n "${YELLOW}"

  while [[ ${printed_header_char} -lt ${header_cols} ]]; do
    echo -n ${header_char}
    ((printed_header_char++))
  done
  
  echo "\n${1}"

  printed_header_char=0

  while [[ ${printed_header_char} -lt ${header_cols} ]]; do
    echo -n ${header_char}
    printed_header_char=$[${printed_header_char}+1]
  done

  echo "${WHITE}\n"
}

function build_prompt() {
  local day=$(date '+%a %b %d %Y')
  local time=$(date '+%H:%M')

  #local left="%F{white}[%F{red}%n%F{white}@%F{red}${HOST}%F{white} : %F{green}%~${vcs_info_msg_0_}%F{white}] "
  #local right=" %F{white}[%F{cyan}${day}, ${time}%F{white}]"
  
  local left="%F{white}[%F{red}%n%F{white}@%F{red}${HOST}%F{white} : %F{red}%~${vcs_info_msg_0_}%F{white}] "
  local right=" %F{white}[%F{red}${day}, ${time}%F{white}]"
  
  local rendered_left=$(print -P "$left")
  local rendered_right=$(print -P "$right")
  
  local plain_left=$(echo "$rendered_left" | sed 's/\x1b\[[0-9;]*m//g')
  local plain_right=$(echo "$rendered_right" | sed 's/\x1b\[[0-9;]*m//g')
  
  local total_width=$(tput cols)
  local fill_len=$(( total_width - ${#plain_left} - ${#plain_right} ))

  if [ $fill_len -lt 0 ]; then
    fill_len=0
  fi

  local fill=$(printf '%*s' $fill_len '' | tr ' ' '-')

  print -P "$left$fill$right"
}

# Search starting at the current directory for a text pattern inside any files
# in the current directory or it's sub directories
# $1 = Search Pattern
function find-in-files {
  if [[ -z ${1} ]]; then
    echo "[${RED}ERROR${WHITE}] No Search Pattern Passed To Command."
    return 1
  fi

  find . -type f -exec grep -i ${1} '{}' \; -print
}

# Get a random quote from an online api.
# If the api call fails, then default to the local ~/.quotes file.
function get-random-quote {
  local api_uri="https://zenquotes.io/api/random"

  local status_code=$(curl --write-out %{http_code} --silent --output /dev/null ${api_uri})
  
  if [[ ${status_code} -eq 200 ]]; then
    response=$(curl -s ${api_uri})

    echo ${response} | jq -r '.[] | "\(.q)\n- \(.a)"' 
  else
    local quote_file=~/.quotes
    local quote_index=$(shuf -i 1-$(sed -n '$=' ${quote_file}) -n 1)

    if [[ $(expr ${quote_index} % 2) -eq 0 ]]; then
      ((quote_index--))
    fi
  
    sed -n "${quote_index}p;$((quote_index + 1))p" ${quote_file} | \
      fold -sw $(echo -n ${PS1} | wc -m)
    fi
}

# Update Permissions On Media Directories / Files
function update-media-permissions {
  base_dir=/mnt
  media_dirs=(movies_0-k movies_l-s movies_t-z tv videos)

  find ${base_dir}/* -type d -exec chmod 700 '{}' \;

  for dir in ${media_dirs}; do
    echo -n "Refreshing ${dir}..."

    find ${base_dir}/${dir} -type f -exec sh -c 'sudo chattr -i "${1}" && chmod 400 "${1}" && sudo chattr +i "${1}"' _ '{}' \;

    echo "Done."
  done
}

# Update Server OS
function update-os {
  sudo apt-get -y update && \
  sudo apt-get -y upgrade && \
  sudo apt-get -y autoremove && \
  sudo apt-get -y autoclean && \
  sudo apt-get -y full-upgrade && \
  sudo do-release-upgrade
}

# Automate The Daily Update Tasks
function setup-env {
  update-os
}