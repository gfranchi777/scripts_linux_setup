alias cat='bat'
alias cls='clear'
alias ex='exit'
alias la='eza -ahl --binary --time-style=long-iso --no-permissions --octal-permissions --group-directories-first --sort=name'
alias ll='eza -hl  --binary --time-style=long-iso --no-permissions --octal-permissions --group-directories-first --sort=name'
alias vi='vim'