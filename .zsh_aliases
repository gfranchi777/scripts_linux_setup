alias apt='sudo apt'
alias cls='clear'
alias df='df -h'
alias ex='exit'
alias ll='ls -lh'
alias la='ls -alh'
alias ls='ls --color=auto'
alias server-upgrade='apt update -y && apt upgrade -y && apt autoremove -y && apt autoclean -y && apt full-upgrade -y && sudo do-release-upgrade'
alias shutdown='sudo shutdown'
alias vi='vim'